QWidget {
    font-family: "Segoe UI";
    font-size: 15px;
    color: #17202a;
    background: #f3f6fa;
}

QLabel#heading {
    font-size: 34px;
    font-weight: 800;
    color: #123a67;
}

QLabel#subtitle {
    color: #607080;
    font-size: 18px;
}

QLabel#sectionTitle {
    font-size: 19px;
    font-weight: 700;
    color: #123a67;
}

QLabel#score {
    font-size: 48px;
    font-weight: 800;
    color: #087f5b;
}

QLabel#choiceTitle {
    font-size: 36px;
    font-weight: 800;
    color: #123a67;
}

QLabel#choiceDescription {
    color: #607080;
    font-size: 17px;
}

QLabel#mutedText {
    color: #607080;
    font-size: 16px;
}

QLabel#summaryBox, QLabel#noticeBox {
    padding: 14px 16px;
    color: #36536f;
    background: #eaf3fb;
    border: 1px solid #bfd7ec;
    border-radius: 8px;
}

QLabel#candidateValue {
    min-height: 30px;
    padding: 4px 10px;
    color: #123a67;
    background: #f7f9fc;
    border: 1px solid #dce4ed;
    border-radius: 5px;
    font-weight: 600;
}

QLabel#timerLabel {
    min-width: 96px;
    font-size: 28px;
    font-weight: 800;
}

QFrame#card, QFrame#studySetupCard, QFrame#studyCard, QFrame#examCard, QGroupBox {
    background: #f3f6fa;
    border: 1px solid #dce4ed;
    border-radius: 10px;
}

QFrame#loginCard {
    background: #f3f6fa;
    border: 1px solid #dce4ed;
    border-radius: 14px;
}

QFrame#studySetupCard QLabel,
QFrame#studySetupCard QComboBox,
QFrame#studySetupCard QSpinBox,
QLabel#summaryBox {
    font-size: 17px;
}

QFrame#studySetupCard QComboBox,
QFrame#studySetupCard QSpinBox {
    min-height: 48px;
}

QLabel#fieldTitle {
    color: #123a67;
    font-size: 18px;
    font-weight: 700;
}

QLabel#fieldLabel {
    min-width: 180px;
    color: #243b53;
    font-size: 17px;
    font-weight: 600;
}

QFrame#sourceOption {
    min-height: 62px;
    background: #ffffff;
    border: 1px solid #c8d5e3;
    border-radius: 9px;
}

QFrame#sourceOption:hover {
    background: #f4f8fc;
    border-color: #78aeda;
}

QFrame#sourceOption[selected="true"] {
    background: #eaf4ff;
    border: 2px solid #1769aa;
}

QRadioButton#sourceRadio {
    min-width: 22px;
    max-width: 22px;
    min-height: 22px;
    padding: 0;
    margin: 0;
    spacing: 0;
    background: transparent;
}

QLabel#sourceTitle {
    color: #123a67;
    background: transparent;
    font-size: 17px;
    font-weight: 700;
}

QLabel#sourceDescription {
    color: #607080;
    background: transparent;
    font-size: 15px;
}

QPushButton#stepButton {
    min-width: 46px;
    max-width: 46px;
    min-height: 46px;
    max-height: 46px;
    padding: 0;
    color: #123a67;
    background: #ffffff;
    border: 2px solid #1769aa;
    border-radius: 7px;
    font-size: 24px;
    font-weight: 800;
}

QPushButton#stepButton:hover {
    color: white;
    background: #1769aa;
}

QPushButton#stepButton:pressed {
    background: #0f568f;
}

QPushButton#stepButton:disabled {
    color: #9aa7b4;
    background: #edf1f5;
    border-color: #c8d0d9;
}

QSpinBox#countValue {
    min-height: 46px;
    padding: 0 12px;
    border: 2px solid #b8cbe0;
    border-radius: 7px;
    font-size: 18px;
    font-weight: 600;
}

QPushButton#secondaryActionButton {
    min-height: 44px;
    color: #123a67;
    background: #edf4fb;
    border: 1px solid #9dbbd5;
}

QPushButton#secondaryActionButton:hover {
    background: #dcecf9;
    border-color: #1769aa;
}

QLabel#dialogHeading {
    color: #123a67;
    font-size: 22px;
    font-weight: 800;
}

QLabel#selectedCount {
    color: #123a67;
    font-size: 16px;
    font-weight: 700;
}

QLabel#selectionHint {
    color: #52677c;
    font-size: 14px;
}

QTableWidget {
    background: white;
    alternate-background-color: #f5f8fb;
    border: 1px solid #c8d5e3;
    border-radius: 7px;
    gridline-color: #e3e9ef;
    selection-background-color: #dceeff;
    selection-color: #17202a;
}

QTableWidget::item {
    padding: 7px;
}

QTableWidget::indicator {
    width: 20px;
    height: 20px;
}

QTableWidget::indicator:unchecked {
    background: #ffffff;
    border: 2px solid #607d9b;
    border-radius: 4px;
}

QTableWidget::indicator:unchecked:hover {
    background: #eaf4ff;
    border-color: #1769aa;
}

QWidget#situationCheckHost {
    background: transparent;
}

QPushButton#situationCheckBox {
    min-width: 16px;
    max-width: 16px;
    min-height: 16px;
    max-height: 16px;
    padding: 0;
    background: transparent;
    border: none;
}

QHeaderView::section {
    padding: 8px;
    color: #123a67;
    background: #eaf0f6;
    border: none;
    border-right: 1px solid #d5dee7;
    border-bottom: 1px solid #c8d5e3;
    font-weight: 700;
}

QFrame#studyCard:hover, QFrame#examCard:hover {
    border: 2px solid #86b8e4;
}

QGroupBox {
    margin-top: 14px;
    padding: 18px 12px 12px 12px;
    font-weight: 700;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 6px;
}

QComboBox, QSpinBox, QLineEdit {
    min-height: 38px;
    padding: 0 10px;
    background: white;
    border: 1px solid #becbd9;
    border-radius: 6px;
}

QComboBox:focus, QSpinBox:focus, QLineEdit:focus {
    border: 2px solid #3686c9;
}

QPushButton {
    min-height: 40px;
    padding: 0 18px;
    background: white;
    border: 1px solid #b8c5d2;
    border-radius: 7px;
    font-weight: 600;
}

QPushButton:hover {
    background: #e9f1fa;
}

QPushButton#primaryButton {
    color: white;
    background: #1769aa;
    border-color: #1769aa;
}

QPushButton#primaryButton:hover {
    background: #0f568f;
}

QPushButton#dangerButton {
    color: white;
    background: #c92a2a;
    border-color: #c92a2a;
}

QRadioButton {
    spacing: 10px;
    min-height: 32px;
    padding: 5px;
    font-weight: 400;
}

QFrame#answerOption {
    min-height: 34px;
    background: #f0f3f7;
    border: 1px solid transparent;
    border-radius: 6px;
}

QFrame#answerOption:hover {
    background: #e7eef6;
    border-color: #c5d5e5;
}

QFrame#answerOption[selected="true"] {
    background: #e5f1fc;
    border-color: #4b91cf;
}

QFrame#answerOption:disabled {
    color: #52606d;
}

QRadioButton#answerRadio {
    min-width: 20px;
    max-width: 20px;
    min-height: 22px;
    padding: 0;
    margin: 0;
    spacing: 0;
    background: transparent;
}

QLabel#answerText {
    color: #17202a;
    background: transparent;
    font-weight: 400;
}

QScrollArea, QVideoWidget {
    background: #111820;
    border: 1px solid #cad5e0;
    border-radius: 7px;
}

QLabel#quickNavLabel {
    color: #52677c;
    font-size: 16px;
    font-weight: 600;
}

QScrollArea#quickNavScroll,
QScrollArea#quickNavScroll QWidget#quickNavHost {
    background: transparent;
    border: none;
}

QPushButton#quickNavButton {
    min-width: 42px;
    max-width: 42px;
    min-height: 38px;
    max-height: 38px;
    padding: 0;
    color: #415a73;
    background: #e7edf4;
    border: 2px solid transparent;
    border-radius: 7px;
    font-size: 16px;
    font-weight: 700;
}

QPushButton#quickNavButton:hover {
    background: #d7e5f2;
}

QPushButton#quickNavButton[status="correct"] {
    color: white;
    background: #198754;
}

QPushButton#quickNavButton[status="incorrect"] {
    color: white;
    background: #c92a2a;
}

QPushButton#quickNavButton[status="answered"] {
    color: white;
    background: #4b7fa8;
}

QPushButton#quickNavButton[current="true"] {
    border: 2px solid #1769aa;
}

/* Situation navigation buttons in sidebar */
QPushButton#situationNavButton {
    background: #eaf0f6;
    border: 1px solid #d5dee7;
    border-radius: 4px;
    color: #2c3e50;
}

QPushButton#situationNavButton:hover {
    background: #d7e5f2;
}

QPushButton#situationNavButton[status="checked"] {
    background: #0d6efd;
    color: white;
    border-color: #0b5ed7;
}

QPushButton#situationNavButton[status="draft"] {
    background: #e8c547;
    color: #2c3e50;
    border-color: #d4a82f;
}

QPushButton#situationNavButton[status="pending"] {
    background: #eaf0f6;
    color: #2c3e50;
}

QPushButton#situationNavButton:checked {
    border: 3px solid #1769aa;
    font-weight: bold;
}

QSlider#videoTimeline::groove:horizontal {
    height: 6px;
    background: #d2dce6;
    border-radius: 3px;
}

QSlider#videoTimeline::sub-page:horizontal {
    background: #1769aa;
    border-radius: 3px;
}

QSlider#videoTimeline::handle:horizontal {
    width: 18px;
    margin: -6px 0;
    background: #1769aa;
    border: 2px solid white;
    border-radius: 9px;
}

QLabel#videoTimeLabel {
    min-width: 108px;
    color: #52677c;
    font-size: 15px;
}

/* ---------- Admin shell ---------- */

QWidget#adminRoot {
    background: #f3f6fa;
}

QFrame#sidebar {
    background: #11243a;
    border: none;
    border-right: 1px solid #0a1828;
}

QFrame#sidebarHeader {
    background: #0a1828;
    border: 1px solid #1b3553;
    border-radius: 8px;
}

QLabel#sidebarTitle {
    color: #ffffff;
    font-size: 17px;
    font-weight: 800;
    letter-spacing: 1px;
    background: transparent;
}

QLabel#sidebarSectionLabel {
    color: #8aa6c4;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1px;
    background: transparent;
}

QListWidget#sidebarMenu {
    background: transparent;
    border: none;
    color: #d8e3ef;
    outline: none;
    padding: 0;
}

QListWidget#sidebarMenu::item {
    padding: 10px 14px;
    margin: 2px 0;
    border: 1px solid transparent;
    border-radius: 6px;
    color: #d8e3ef;
    background: transparent;
    font-weight: 600;
}

QListWidget#sidebarMenu::item:hover {
    background: #1a3553;
    border-color: #2a4d72;
    color: #ffffff;
}

QListWidget#sidebarMenu::item:selected {
    background: #1769aa;
    border-color: #2476bb;
    color: #ffffff;
}

QPushButton#sidebarLogout {
    background: #1a3553;
    border: 1px solid #2a4d72;
    color: #d8e3ef;
    border-radius: 7px;
}

QPushButton#sidebarLogout:hover {
    background: #2a4d72;
    color: #ffffff;
}

QStackedWidget#adminContent {
    background: #f3f6fa;
    border: none;
}

/* ---------- Login card ---------- */

QFrame#loginCard {
    background: white;
    border: 1px solid #dce4ed;
    border-radius: 14px;
}

QLabel#loginIcon {
    font-size: 52px;
    background: transparent;
    color: #1769aa;
}

QLabel#fieldLabel {
    color: #243b53;
    font-size: 17px;
    font-weight: 700;
    background: transparent;
    padding: 0;
}

QLineEdit#loginInput {
    min-height: 44px;
    padding: 0 14px;
    background: #f3f6fa;
    border: 1px solid #becbd9;
    border-radius: 8px;
    font-size: 16px;
}

QLineEdit#loginInput:focus {
    background: #f3f6fa;
    border: 2px solid #3686c9;
}

QFrame#loginCard {
    background: #f3f6fa;
}

QFrame#loginCard QLabel,
QFrame#loginCard QLineEdit {
    background: #f3f6fa;
}

QPushButton#ghostButton {
    background: transparent;
    border: 1px solid #b8c5d2;
    color: #243b53;
}

QPushButton#ghostButton:hover {
    background: #eef3f8;
}

QLabel#errorText {
    color: #c92a2a;
    font-size: 14px;
    font-weight: 600;
    background: #f3f6fa;
    border: 1px solid #f3b8b8;
    border-radius: 6px;
    padding: 8px 10px;
}

/* ---------- Mode Cards ---------- */

QFrame#modeCard {
    background: white;
    border: 2px solid #dce4ed;
    border-radius: 14px;
}

QFrame#modeCard:hover {
    border-color: #86b8e4;
    background: #f8fbff;
}

QFrame#modeCard[selected="true"] {
    border-color: #1769aa;
    background: #eaf4ff;
}

QLabel#modeIcon {
    font-size: 42px;
    background: transparent;
}

QLabel#modeTitle {
    font-size: 22px;
    font-weight: 800;
    color: #123a67;
    background: transparent;
}

QLabel#modeDescription {
    color: #607080;
    font-size: 15px;
    background: transparent;
}

/* ---------- Duration Slider ---------- */

QSlider#durationSlider {
    min-height: 40px;
}

QSlider#durationSlider::groove:horizontal {
    height: 8px;
    background: #d2dce6;
    border-radius: 4px;
}

QSlider#durationSlider::sub-page:horizontal {
    background: #1769aa;
    border-radius: 4px;
}

QSlider#durationSlider::handle:horizontal {
    width: 24px;
    height: 24px;
    margin: -8px 0;
    background: #1769aa;
    border: 3px solid white;
    border-radius: 12px;
}

QSlider#durationSlider::handle:horizontal:hover {
    background: #0f568f;
}

QSlider#durationSlider::add-page:horizontal {
    background: #d2dce6;
    border-radius: 4px;
}

QLabel#durationValue {
    font-size: 28px;
    font-weight: 800;
    color: #1769aa;
    background: transparent;
}

/* ---------- Practice Session Dropdown ---------- */

QWidget#chapterDropdown {
    background: transparent;
    border: none;
}

QPushButton#chapterDropdownHeader {
    min-height: 40px;
    padding: 0 14px;
    background: white;
    border: 1px solid #b8c5d2;
    border-radius: 7px;
    font-weight: 600;
    text-align: left;
    color: #243b53;
}

QPushButton#chapterDropdownHeader:hover {
    background: #e9f1fa;
    border-color: #78aeda;
}

QPushButton#chapterDropdownHeader:pressed {
    background: #dcecf5;
}

#chapterDropdown QPushButton[accessibleName="chapterBtn"] {
    min-height: 34px;
    padding: 0 12px;
    background: white;
    border: 1px solid #d0dbe6;
    border-radius: 6px;
    font-weight: 500;
    text-align: left;
}

#chapterDropdown QPushButton[accessibleName="chapterBtn"]:hover {
    background: #eaf3fb;
    border-color: #78aeda;
}

#chapterDropdown QPushButton[accessibleName="chapterBtn"]:checked {
    background: #e5f1fc;
    border: 2px solid #1769aa;
    color: #123a67;
    font-weight: 700;
}

/* ---------- Practice Sidebar ---------- */

QFrame#practiceSidebar {
    background: #f3f6fa;
    border: 1px solid #dce4ed;
    border-radius: 8px;
}
