QWidget {
    font-family: "Segoe UI";
    font-size: 15px;
    color: #17202a;
    background: #f3f6fa;
}

QLabel#heading {
    font-size: 34px;
    font-weight: 800;
    color: #123a67;
}

QLabel#subtitle {
    color: #607080;
    font-size: 18px;
}

QLabel#sectionTitle {
    font-size: 19px;
    font-weight: 700;
    color: #123a67;
}

QLabel#score {
    font-size: 48px;
    font-weight: 800;
    color: #087f5b;
}

QLabel#choiceTitle {
    font-size: 29px;
    font-weight: 800;
    color: #123a67;
}

QLabel#choiceDescription {
    color: #607080;
    font-size: 17px;
}

QLabel#mutedText {
    color: #607080;
    font-size: 16px;
}

QLabel#summaryBox, QLabel#noticeBox {
    padding: 14px 16px;
    color: #36536f;
    background: #eaf3fb;
    border: 1px solid #bfd7ec;
    border-radius: 8px;
}

QLabel#candidateValue {
    min-height: 30px;
    padding: 4px 10px;
    color: #123a67;
    background: #f7f9fc;
    border: 1px solid #dce4ed;
    border-radius: 5px;
    font-weight: 600;
}

QLabel#timerLabel {
    min-width: 96px;
    font-size: 28px;
    font-weight: 800;
}

QFrame#card, QFrame#studySetupCard, QFrame#studyCard, QFrame#examCard, QGroupBox {
    background: white;
    border: 1px solid #dce4ed;
    border-radius: 10px;
}

QFrame#studySetupCard QLabel,
QFrame#studySetupCard QComboBox,
QFrame#studySetupCard QSpinBox,
QLabel#summaryBox {
    font-size: 17px;
}

QFrame#studySetupCard QComboBox,
QFrame#studySetupCard QSpinBox {
    min-height: 48px;
}

QFrame#studyCard:hover, QFrame#examCard:hover {
    border: 2px solid #86b8e4;
}

QGroupBox {
    margin-top: 14px;
    padding: 18px 12px 12px 12px;
    font-weight: 700;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 6px;
}

QComboBox, QSpinBox, QLineEdit {
    min-height: 38px;
    padding: 0 10px;
    background: white;
    border: 1px solid #becbd9;
    border-radius: 6px;
}

QComboBox:focus, QSpinBox:focus, QLineEdit:focus {
    border: 2px solid #3686c9;
}

QPushButton {
    min-height: 40px;
    padding: 0 18px;
    background: white;
    border: 1px solid #b8c5d2;
    border-radius: 7px;
    font-weight: 600;
}

QPushButton:hover {
    background: #e9f1fa;
}

QPushButton#primaryButton {
    color: white;
    background: #1769aa;
    border-color: #1769aa;
}

QPushButton#primaryButton:hover {
    background: #0f568f;
}

QPushButton#dangerButton {
    color: white;
    background: #c92a2a;
    border-color: #c92a2a;
}

QRadioButton {
    spacing: 10px;
    min-height: 32px;
    padding: 5px;
    font-weight: 400;
}

QFrame#answerOption {
    min-height: 34px;
    background: #f0f3f7;
    border: 1px solid transparent;
    border-radius: 6px;
}

QFrame#answerOption:hover {
    background: #e7eef6;
    border-color: #c5d5e5;
}

QFrame#answerOption[selected="true"] {
    background: #e5f1fc;
    border-color: #4b91cf;
}

QFrame#answerOption:disabled {
    color: #52606d;
}

QRadioButton#answerRadio {
    min-width: 20px;
    max-width: 20px;
    min-height: 22px;
    padding: 0;
    margin: 0;
    spacing: 0;
    background: transparent;
}

QLabel#answerText {
    color: #17202a;
    background: transparent;
    font-weight: 400;
}

QScrollArea, QVideoWidget {
    background: #111820;
    border: 1px solid #cad5e0;
    border-radius: 7px;
}
